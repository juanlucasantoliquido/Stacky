auth/auth.json
auth/ado_auth.json
Stacky Agents/backend/.env
Stacky Agents/backend/.env.local
Stacky Agents/backend/projects/*/auth/*.json
!Stacky Agents/backend/.env.example

# Credenciales y secrets del agente QA UAT (y otros agentes)
.secrets/*.env
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/

# Estado runtime — no versionar
pipeline/state.json
state/
active_project.json
# Estado y salidas del migrador Mantis→GitLab: checkpoints de reanudacion y reportes
# de corridas reales (llevan nombre de operador y data del cliente en el nombre).
Stacky Agents/backend/run_state/
Stacky Agents/backend/reports/
# DB viva del runtime — binario, no versionar
data/
*.db
*.sqlite
*.sqlite3
NOTIFICATIONS.json

# Proyectos / tickets scrapeados — contienen datos del cliente.
# La regla es DELIBERADAMENTE amplia: hay ~90 carpetas "projects" con datos reales
# (backend/projects, Stacky Agents/projects, DeployStackyAgents/projects y sus backups,
# deployment/.prepare-out). Acotarla a una sola ruta las destaparia.
projects/

# EXCEPCION: esto es CODIGO FUENTE del frontend, no data de cliente. Sin esta linea
# la regla de arriba lo tapa y los modulos solo entran con `git add -f` — o se pierden
# EN SILENCIO cuando alguien se olvida (paso con el plan 259).
!Stacky Agents/frontend/src/projects/

# Credenciales y sesiones. Tambien amplia a proposito: cubre las carpetas auth/ que
# viven dentro de cada projects/<CLIENTE>/.
auth/

# Logs
*.log
logs/
test_logs/

# Artefactos de build / temporales
dist/
build/
*.zip

# Deploys locales de Stacky Agents
Stacky Agents/DeployStackyAgents/

# Agentes canónicos versionados. El manifest se regenera en runtime/release.
Stacky Agents/backend/Stacky/*
!Stacky Agents/backend/Stacky/agents/
!Stacky Agents/backend/Stacky/agents/**
!Stacky Agents/backend/Stacky/agents/*.agent.md
Stacky Agents/backend/Stacky/agents/manifest.json
# Skills: carpeta versionada (fixture de ejemplo para tests + documento de referencia)
!Stacky Agents/backend/Stacky/skills/
!Stacky Agents/backend/Stacky/skills/**

# VS Code
.vscode/

# Repo clonado localmente para referencia
engram/

# Volcado de memoria de herramienta externa (no es código del proyecto)
/memory/

# Backups de node_modules dejados por reinstalaciones (Install-Dependencies.ps1)
node_modules.stale-*/

# Entornos virtuales de Python (machine-specific, nunca versionar)
venv/
.venv/

# Worktrees de git creados DENTRO de la raiz del repo (wt-plan-260, wt-main-consolidation,
# etc.). Al vivir adentro aparecen como carpetas untracked en `git status` y ensucian el
# inventario: se llegaron a acumular 7 worktrees de planes ya consolidados. Anclado a la
# raiz con `/` para no tapar nada anidado.
/wt-*/

